---
interface Venue {
  name: string;
  detail: string;
  mapsUrl?: string;
}

interface Props {
  venues: Venue[];
}

const { venues } = Astro.props;
---

<section class="w-full bg-surface-container text-on-surface px-6 py-16 flex flex-col items-center relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-tr from-tertiary-container/20 to-transparent pointer-events-none"></div>

  <div class="w-full max-w-[320px] md:max-w-none flex flex-col items-center gap-12 z-10">
    <h2 class="font-script text-5xl md:text-6xl text-primary text-center mb-4">Ubicación</h2>

    <div class="w-full flex flex-col md:flex-row md:justify-center md:gap-16 items-center gap-12">
      {venues.map((venue, i) => (
        <div class="flex flex-col items-center text-center w-full md:w-auto md:max-w-xs group">
          <span class="material-symbols-outlined text-primary mb-2">location_on</span>
          <h3 class="font-headline-md text-xl md:text-2xl mb-2">{venue.name}</h3>
          <p class="font-body-md text-on-surface-variant mb-6 md:text-lg">{venue.detail}</p>
          <a
            href={venue.mapsUrl ?? '#'}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-8 py-3 bg-primary text-on-primary font-label-caps text-[10px] tracking-widest rounded-full hover:bg-on-primary-fixed-variant transition-colors duration-300 shadow-sm"
          >
            COMO LLEGAR
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
