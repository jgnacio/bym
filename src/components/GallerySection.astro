---
interface GalleryImage {
  src: string;
  alt: string;
  featured?: boolean;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;

const [featured, ...rest] = images;
---

<section class="w-full px-4 md:px-6 mb-16">
  <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
    {featured && (
      <div class="col-span-2 md:col-span-3">
        <img
          src={featured.src}
          alt={featured.alt}
          class="w-full h-56 md:h-72 object-cover rounded-3xl shadow-sm"
        />
      </div>
    )}
    {rest.map((img) => (
      <div>
        <img
          src={img.src}
          alt={img.alt}
          class="w-full h-48 md:h-56 object-cover rounded-3xl shadow-sm"
        />
      </div>
    ))}
  </div>
</section>
