---
interface CalendarDay {
  day: number;
  highlighted?: boolean;
}

interface Props {
  photoSrc: string;
  photoAlt?: string;
  monthLabel: string;
  dateDescription: string;
  highlightedDay: number;
  monthStartOffset: number;
  totalDays: number;
}

const {
  photoSrc,
  photoAlt = 'Romantic outdoor portrait',
  monthLabel,
  dateDescription,
  highlightedDay,
  monthStartOffset,
  totalDays,
} = Astro.props;

const emptySlots = Array(monthStartOffset).fill(null);
const days = Array.from({ length: totalDays }, (_, i) => i + 1);
---

<section class="w-full bg-surface-container-low text-on-surface px-6 md:px-10 py-12 md:py-16 flex flex-col md:flex-row items-center md:items-start md:gap-12 relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-primary-container/20 to-transparent pointer-events-none"></div>

  <div class="w-full md:w-1/2 mb-10 md:mb-0 z-10 relative flex-shrink-0">
    <img
      src={photoSrc}
      alt={photoAlt}
      class="w-full h-64 md:h-full md:max-h-[480px] rounded-3xl shadow-md object-cover border-4 border-surface-container-highest"
    />
  </div>

  <div class="w-full md:w-1/2 flex flex-col items-center md:items-start gap-8 z-10 md:pt-4">
    <div class="flex flex-col items-center md:items-start text-center md:text-left pb-6 border-b border-primary/20 w-full">
      <span class="font-script text-4xl md:text-5xl text-primary mb-2">{monthLabel}</span>
      <p class="font-body-md text-on-surface-variant mt-4 leading-relaxed md:text-lg" set:html={dateDescription} />
    </div>

    <div class="w-full max-w-[320px] md:max-w-none flex flex-col gap-4">
      <div class="grid grid-cols-7 gap-2 text-center font-label-caps text-[10px] text-primary/80 mb-2">
        {['D', 'L', 'M', 'M', 'J', 'V', 'S'].map((d) => <span>{d}</span>)}
      </div>
      <div class="grid grid-cols-7 gap-y-4 gap-x-2 text-center font-body-md text-sm md:text-base">
        {emptySlots.map(() => <span class="text-on-surface/10"></span>)}
        {days.map((day) =>
          day === highlightedDay ? (
            <span class="relative flex justify-center items-center w-8 h-8 rounded-full bg-secondary-container/50 border border-secondary mx-auto">
              <span class="z-10 text-secondary font-bold">{day}</span>
              <span
                class="material-symbols-outlined text-secondary absolute -top-3 text-xs"
                style='font-variation-settings: "FILL" 1;'
              >favorite</span>
            </span>
          ) : (
            <span>{day}</span>
          )
        )}
      </div>
    </div>
  </div>
</section>
