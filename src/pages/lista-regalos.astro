---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Estado de los regalos - Mauro & Barbi" showSplash={false}>
  <main class="flex-grow flex flex-col items-center w-full max-w-md md:max-w-2xl mx-auto px-6 py-10 md:py-16">
    <a
      href="/"
      class="self-start mb-6 inline-flex items-center gap-1 text-primary/70 font-body-md text-sm hover:text-primary transition-colors"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M13 8H3M7 4L3 8l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      Volver al inicio
    </a>

    <span class="material-symbols-outlined text-tertiary text-4xl mb-2">checklist</span>
    <h1 class="font-headline-md text-2xl md:text-3xl text-primary mb-2 text-center">Estado de los regalos</h1>
    <p class="font-body-md text-on-surface-variant text-center mb-8 max-w-md">
      Quién ya nos regaló qué. Tocá un nombre para ver los detalles.
    </p>

    <div id="overview-root" class="w-full"></div>
  </main>

  <div
    id="guest-modal"
    class="hidden fixed inset-0 z-50 items-center justify-center bg-black/40 px-6"
  >
    <div class="w-full max-w-sm bg-surface rounded-2xl p-6 shadow-lg">
      <span class="font-label-caps text-[10px] uppercase tracking-wide text-primary/60" id="guest-modal-gift"></span>
      <h2 class="font-headline-md text-lg text-primary mb-1" id="guest-modal-name"></h2>
      <p class="font-body-md text-sm text-on-surface-variant mb-6" id="guest-modal-phone"></p>

      <div class="flex flex-col gap-2">
        <a
          id="guest-modal-whatsapp"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full text-center px-4 py-2.5 rounded-full bg-primary text-on-primary font-body-md text-sm hover:opacity-90 transition-opacity"
        >
          Enviar mensaje
        </a>
        <button
          type="button"
          id="guest-modal-delete"
          class="w-full px-4 py-2.5 rounded-full border border-error text-error font-body-md text-sm hover:bg-error/5 transition-colors"
        >
          Eliminar
        </button>
        <button
          type="button"
          id="guest-modal-close"
          class="w-full px-4 py-2.5 rounded-full text-on-surface-variant font-body-md text-sm hover:text-on-surface transition-colors"
        >
          Cerrar
        </button>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase, type GiftCategory, type GiftItem, type CustomReservation } from '../lib/supabase';

  function escapeHtml(value: string) {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function whatsAppLink(phone: string, giftName: string) {
    const digits = phone.replace(/\D/g, '').replace(/^0/, '');
    const message = `¡Hola! Vimos que nos regalaste ${giftName}, ¡muchísimas gracias! 💚`;
    return `https://wa.me/598${digits}?text=${encodeURIComponent(message)}`;
  }

  const root = document.getElementById('overview-root')!;

  function renderLoading() {
    root.innerHTML = `
      <div class="flex justify-center py-16">
        <span class="material-symbols-outlined text-primary/40 text-3xl animate-spin">progress_activity</span>
      </div>
    `;
  }

  function reservedBadge(reservationId: string, name: string, giftName: string) {
    return `
      <button
        type="button"
        data-action="show-guest"
        data-reservation-id="${reservationId}"
        data-name="${escapeHtml(name)}"
        data-gift="${escapeHtml(giftName)}"
        class="font-body-md text-xs text-primary hover:underline"
      >
        ${escapeHtml(name)}
      </button>
    `;
  }

  function render(categories: GiftCategory[], items: GiftItem[], customReservations: CustomReservation[]) {
    const reservedCount = items.filter((i) => i.is_reserved).length + customReservations.length;
    const totalCount = items.length + customReservations.length;

    const byCategory = categories
      .map((cat) => ({
        category: cat,
        items: items.filter((i) => i.category_id === cat.id),
      }))
      .filter((group) => group.items.length > 0);

    const categoryBlocks = byCategory
      .map(
        (group) => `
        <div class="mb-5">
          <h3 class="font-label-caps text-xs uppercase tracking-wide text-primary/60 mb-2">${escapeHtml(group.category.name)}</h3>
          <ul class="flex flex-col gap-1.5">
            ${group.items
              .map(
                (item) => `
                <li class="flex items-center justify-between gap-2 px-4 py-2.5 rounded-xl bg-surface-container-low">
                  <span class="font-body-md text-sm text-on-surface">${escapeHtml(item.name)}</span>
                  ${
                    item.is_reserved && item.reservation_id
                      ? reservedBadge(item.reservation_id, item.reserved_by ?? 'Reservado', item.name)
                      : '<span class="font-body-md text-xs text-on-surface-variant/50">Disponible</span>'
                  }
                </li>
              `,
              )
              .join('')}
          </ul>
        </div>
      `,
      )
      .join('');

    const customBlock = customReservations.length
      ? `
        <div class="mb-5">
          <h3 class="font-label-caps text-xs uppercase tracking-wide text-primary/60 mb-2">Otros regalos</h3>
          <ul class="flex flex-col gap-1.5">
            ${customReservations
              .map(
                (c) => `
                <li class="flex items-center justify-between gap-2 px-4 py-2.5 rounded-xl bg-surface-container-low">
                  <span class="font-body-md text-sm text-on-surface">${escapeHtml(c.custom_item_name)}</span>
                  ${reservedBadge(c.id, c.guest_name, c.custom_item_name)}
                </li>
              `,
              )
              .join('')}
          </ul>
        </div>
      `
      : '';

    root.innerHTML = `
      <p class="font-body-md text-sm text-on-surface-variant mb-6">${reservedCount} de ${totalCount} regalos reservados</p>
      ${categoryBlocks}
      ${customBlock}
    `;
  }

  const guestReservationPhones = new Map<string, string | null>();

  function indexPhones(items: GiftItem[], customReservations: CustomReservation[]) {
    guestReservationPhones.clear();
    for (const item of items) {
      if (item.reservation_id) guestReservationPhones.set(item.reservation_id, item.reserved_phone);
    }
    for (const c of customReservations) {
      guestReservationPhones.set(c.id, c.guest_phone);
    }
  }

  async function load() {
    renderLoading();

    const [categoriesRes, itemsRes, customRes] = await Promise.all([
      supabase.from('gift_categories').select('*').order('sort_order', { ascending: true }),
      supabase.from('gift_items_availability').select('*').order('sort_order', { ascending: true }),
      supabase
        .from('gift_custom_reservations_public')
        .select('*')
        .order('created_at', { ascending: false }),
    ]);

    if (categoriesRes.error || itemsRes.error || customRes.error) {
      root.innerHTML = `<p class="text-error font-body-md text-sm text-center py-10">No pudimos cargar el estado de la lista.</p>`;
      return;
    }

    const items = itemsRes.data ?? [];
    const customReservations = customRes.data ?? [];
    indexPhones(items, customReservations);
    render(categoriesRes.data ?? [], items, customReservations);
  }

  const modal = document.getElementById('guest-modal')!;
  const modalGift = document.getElementById('guest-modal-gift')!;
  const modalName = document.getElementById('guest-modal-name')!;
  const modalPhone = document.getElementById('guest-modal-phone')!;
  const modalWhatsapp = document.getElementById('guest-modal-whatsapp')! as HTMLAnchorElement;
  const modalDelete = document.getElementById('guest-modal-delete')! as HTMLButtonElement;
  const modalClose = document.getElementById('guest-modal-close')!;

  let pendingReservationId: string | null = null;

  function openGuestModal(reservationId: string, name: string, giftName: string) {
    const phone = guestReservationPhones.get(reservationId) ?? null;
    pendingReservationId = reservationId;

    modalGift.textContent = giftName;
    modalName.textContent = name;
    modalPhone.textContent = phone ?? 'Sin teléfono';

    if (phone) {
      modalWhatsapp.href = whatsAppLink(phone, giftName);
      modalWhatsapp.classList.remove('hidden');
    } else {
      modalWhatsapp.classList.add('hidden');
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeGuestModal() {
    pendingReservationId = null;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  root.addEventListener('click', (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-action="show-guest"]');
    if (!btn) return;
    openGuestModal(btn.dataset.reservationId!, btn.dataset.name ?? '', btn.dataset.gift ?? '');
  });

  modalClose.addEventListener('click', closeGuestModal);

  modalDelete.addEventListener('click', async () => {
    if (!pendingReservationId) return;
    if (!confirm('¿Seguro que querés eliminar esta reserva?')) return;

    modalDelete.disabled = true;
    modalDelete.textContent = 'Eliminando...';

    await supabase.from('gift_reservations').delete().eq('id', pendingReservationId);

    modalDelete.disabled = false;
    modalDelete.textContent = 'Eliminar';
    closeGuestModal();
    load();
  });

  load();
</script>
